---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import TableOfContents from "../components/TableOfContents.astro";
import Sidebar from "../components/Sidebar.astro";
import { CATEGORIES } from "../consts";

interface Props {
  post: CollectionEntry<"posts"> | CollectionEntry<"notes">;
}

const { post } = Astro.props;
const { title, date, updated, categories, tags, description } = post.data;

const { headings } = post.rendered ?? { headings: [] };

const postCategories = CATEGORIES.filter((c) =>
  (categories ?? []).includes(c.slug)
);
const typeLabel = post.collection === "notes" ? "笔记" : "文章";
---

<BaseLayout
  title={title}
  description={description}
>
  <div class="page-layout">
    <main class="main-content">
      <article>
        <header class="article-header">
          <h1>{title}</h1>
          <div class="article-meta">
            <time datetime={date.toISOString()}>
              {date.toLocaleDateString("zh-CN", {
                year: "numeric",
                month: "long",
                day: "numeric",
              }) + " " + date.toLocaleTimeString("zh-CN", { hour: "2-digit", minute: "2-digit" })}
            </time>
            <span>{typeLabel}</span>
            {postCategories.map((c) => (
              <a href={`/categories/${c.slug}`}>{c.emoji} {c.label}</a>
            ))}
          </div>
        </header>

        <TableOfContents headings={headings} />

        <div class="article-body">
          <slot />
        </div>

        <footer class="article-footer">
          {tags && tags.length > 0 && (
            <p class="article-tags">
              {tags.map((t) => (
                <a href={`/categories/${t}`} class="tag-pill">{t}</a>
              ))}
            </p>
          )}
          {updated && (
            <p class="article-updated">
              修改于{" "}
              {updated.toLocaleDateString("zh-CN", {
                year: "numeric",
                month: "long",
                day: "numeric",
              }) + " " + updated.toLocaleTimeString("zh-CN", { hour: "2-digit", minute: "2-digit" })}
            </p>
          )}
          <p class="article-footer-links">
            <a href="/">← 返回首页</a>
            {post.collection === "posts" && (
              <a
                id="edit-post-link"
                href={`/auth?edit=${post.id}`}
                style="display:none;color:var(--color-accent);"
              >编辑此文章</a>
            )}
          </p>
        </footer>
      </article>
    </main>
    <Sidebar />
  </div>
</BaseLayout>

<script>
  if (localStorage.getItem("publish_token")) {
    const link = document.getElementById("edit-post-link");
    if (link) link.style.display = "";
  }
</script>
