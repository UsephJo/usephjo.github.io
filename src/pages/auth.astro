---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts");
const postsData = posts.map((p) => ({
  id: p.id,
  title: p.data.title,
  date: p.data.date.toISOString(),
  categories: p.data.categories ?? [],
  tags: p.data.tags ?? [],
  rss: p.data.rss,
  slug: p.id.replace(/\.md$/, ""),
}));
---

<BaseLayout title="管理">
  <div id="auth-root">
    <!-- State A: Token Setup -->
    <div id="auth-setup" class="auth-state" style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:50vh;text-align:center;">
      <div style="font-size:3rem;margin-bottom:1.5rem;">&#128274;</div>
      <h2 style="margin-bottom:0.5rem;">登录</h2>
      <p style="color:var(--color-text-muted);font-size:0.9rem;margin-bottom:2rem;line-height:1.6;">
        输入 GitHub Personal Access Token，<br />令牌仅保存在你的浏览器中。
      </p>
      <div style="width:100%;max-width:380px;text-align:left;margin-bottom:1rem;">
        <label for="token-input" style="display:block;font-size:0.82rem;font-weight:600;color:var(--color-text-muted);margin-bottom:0.3rem;text-transform:uppercase;letter-spacing:0.05em;">Token</label>
        <input id="token-input" type="password" placeholder="ghp_..." autocomplete="off" style="width:100%;padding:0.75rem 0.9rem;border:1px solid var(--color-border);border-radius:8px;font-size:0.92rem;background:var(--color-bg);color:var(--color-text);font-family:var(--font-mono);" />
        <p style="font-size:0.75rem;color:var(--color-text-muted);margin-top:0.3rem;">
          没有令牌？去 <a href="https://github.com/settings/tokens/new?scopes=repo&description=usephjo-blog-publish" target="_blank" style="color:var(--color-accent);">这里创建一个</a>，勾选 repo 权限。
        </p>
      </div>
      <button id="btn-save" class="auth-btn auth-btn-primary">验证并进入</button>
      <p id="token-error" style="color:#dc2626;font-size:0.85rem;margin-top:0.5rem;display:none;"></p>
    </div>

    <!-- State B: Dashboard -->
    <div id="auth-dashboard" class="auth-state" style="display:none;">
      <div class="page-layout">
        <main class="main-content">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;">
            <h2 style="margin:0;font-size:1.2rem;">文章管理</h2>
            <div style="display:flex;align-items:center;gap:0.8rem;">
              <span style="font-size:0.78rem;color:var(--color-text-muted);display:flex;align-items:center;gap:0.3rem;">
                <span style="width:6px;height:6px;border-radius:50%;background:#16a34a;display:inline-block;"></span> 已连接
              </span>
            </div>
          </div>
          <div id="post-list">
            {postsData.length === 0 ? (
              <p style="color:var(--color-text-muted);">还没有文章，点击右侧「新增内容」开始写作。</p>
            ) : (
              postsData.map((post) => (
                <div class="post-item" data-filename={post.id}>
                  <div class="post-item-main">
                    <a href={`/posts/${post.slug}/`} class="post-item-title">{post.title}</a>
                    <div class="post-item-meta">
                      <time>{new Date(post.date).toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" })}</time>
                      {post.categories.length > 0 && (
                        <span> · {post.categories.join(", ")}</span>
                      )}
                      {!post.rss && <span style="color:var(--color-accent);"> · 未推送</span>}
                    </div>
                  </div>
                  <div class="post-item-actions">
                    <button class="btn-edit-post auth-btn-sm" data-filename={post.id}>编辑</button>
                    <a href={`/posts/${post.slug}/`} class="auth-btn-sm" style="color:var(--color-text-muted);text-decoration:none;">查看</a>
                  </div>
                </div>
              ))
            )}
          </div>
        </main>
        <aside class="sidebar">
          <div class="sidebar-section">
            <h3>操作</h3>
            <ul>
              <li><a href="#" id="btn-new-post-sidebar">+ 新增内容</a></li>
              <li><a href="/" style="color:var(--color-text-muted);">← 返回首页</a></li>
            </ul>
          </div>
          <div class="sidebar-section">
            <h3>账号</h3>
            <ul>
              <li><a href="#" id="btn-logout" style="color:var(--color-text-muted);">退出登录</a></li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </div>

  <!-- State C: Editor Overlay -->
  <div id="auth-editor-overlay" style="display:none;position:fixed;inset:0;z-index:1000;background:var(--color-bg);">
    <div id="auth-editor" style="display:flex;flex-direction:column;height:100%;">
      <div class="ae-top-bar">
        <div style="display:flex;align-items:center;gap:1rem;">
          <button id="btn-close-editor" class="auth-btn-ghost">&larr; 返回</button>
          <span style="font-size:0.9rem;font-weight:600;color:var(--color-text-muted);">
            <span style="width:7px;height:7px;border-radius:50%;background:#16a34a;display:inline-block;margin-right:0.4rem;"></span>
            <span id="editor-mode-label">写点什么</span>
          </span>
        </div>
        <span id="editor-filename" style="font-size:0.75rem;color:var(--color-text-muted);"></span>
      </div>
      <div class="ae-split">
        <div class="ae-pane ae-pane-left">
          <div class="ae-pane-label">Markdown</div>
          <div class="ae-toolbar">
            <button id="btn-image" title="上传图片"><span>&#128247;</span> 图片</button>
            <button id="btn-link-card" title="粘贴链接生成卡片"><span>&#128279;</span> 链接卡片</button>
            <span style="font-size:0.72rem;color:var(--color-text-muted);margin-left:auto;line-height:2;">支持粘贴图片、Apple Music、网页链接</span>
          </div>
          <div class="ae-pane-content">
            <textarea id="content-area" placeholder="第一行是标题&#10;空一行&#10;开始写正文..."></textarea>
          </div>
          <input type="file" id="file-input" accept="image/*" style="display:none" multiple />
        </div>
        <div class="ae-pane">
          <div class="ae-pane-label">预览</div>
          <div class="ae-pane-content">
            <div id="preview" class="ae-preview" style="color:var(--color-text-muted);font-style:italic;">在左边输入内容，这里会实时渲染……</div>
          </div>
        </div>
      </div>
      <div class="ae-bottom-bar">
        <div class="ae-opt-group">
          <label for="categories-input">分类</label>
          <input id="categories-input" type="text" placeholder="tech, life" />
        </div>
        <div class="ae-opt-group">
          <label for="tags-input">标签</label>
          <input id="tags-input" type="text" placeholder="astro, blog" />
        </div>
        <div style="flex:1;"></div>
        <label class="ae-checkbox" title="取消勾选后不出现在 RSS 中">
          <input type="checkbox" id="rss-check" checked />
          <span>推送到 RSS</span>
        </label>
        <button id="btn-publish" class="auth-btn-publish">发布</button>
        <span style="font-size:0.78rem;color:var(--color-text-muted);"><kbd style="background:var(--color-border);padding:0.12em 0.45em;border-radius:4px;font-size:0.88em;">&#8984;</kbd> <kbd style="background:var(--color-border);padding:0.12em 0.45em;border-radius:4px;font-size:0.88em;">Enter</kbd></span>
        <span id="char-count" style="font-size:0.78rem;color:var(--color-text-muted);">0 字</span>
      </div>
    </div>
  </div>

  <div id="toast" class="auth-toast"></div>
</BaseLayout>

<script type="application/json" id="posts-data">
{JSON.stringify(postsData)}
</script>

<style is:global>
  /* ===== Auth shared ===== */
  .auth-btn {
    padding: 0.7rem 1.6rem; border: none; border-radius: 8px;
    font-size: 0.95rem; font-weight: 600; cursor: pointer;
    transition: all 0.15s; font-family: inherit;
  }
  .auth-btn-primary { background: var(--color-accent); color: #fff; width: 100%; max-width: 380px; }
  .auth-btn-primary:hover { opacity: 0.88; transform: translateY(-1px); }
  .auth-btn-ghost {
    background: transparent; color: var(--color-text-muted);
    border: 1px solid var(--color-border); font-weight: 500;
    font-size: 0.82rem; padding: 0.4rem 0.8rem; border-radius: 6px;
    cursor: pointer; font-family: inherit;
  }
  .auth-btn-ghost:hover { background: var(--color-border); }
  .auth-btn-sm {
    padding: 0.25rem 0.6rem; border: 1px solid var(--color-border);
    border-radius: 5px; background: var(--color-bg); color: var(--color-text-muted);
    cursor: pointer; font-size: 0.76rem; font-family: inherit;
    transition: all 0.15s; text-decoration: none; display: inline-block;
  }
  .auth-btn-sm:hover { background: var(--color-border); color: var(--color-text); }
  .auth-btn-publish {
    padding: 0.5rem 1.4rem; background: var(--color-text); color: var(--color-bg);
    border: none; border-radius: 8px; font-size: 0.9rem; font-weight: 600;
    cursor: pointer; font-family: inherit; transition: all 0.15s;
  }
  .auth-btn-publish:hover { opacity: 0.85; }
  .auth-btn-publish:disabled { opacity: 0.4; cursor: not-allowed; }

  /* ===== Post list items ===== */
  .post-item {
    display: flex; align-items: center; justify-content: space-between;
    padding: 0.9rem 0; border-bottom: 1px solid var(--color-border);
    gap: 1rem;
  }
  .post-item:last-child { border-bottom: none; }
  .post-item-main { flex: 1; min-width: 0; }
  .post-item-title {
    font-size: 1rem; font-weight: 600; color: var(--color-text); text-decoration: none;
  }
  .post-item-title:hover { color: var(--color-accent); }
  .post-item-meta {
    font-size: 0.78rem; color: var(--color-text-muted); margin-top: 0.2rem;
  }
  .post-item-actions { display: flex; gap: 0.4rem; flex-shrink: 0; }

  /* ===== Editor overlay ===== */
  .ae-top-bar {
    display: flex; align-items: center; justify-content: space-between;
    padding: 0.8rem 1.5rem; border-bottom: 1px solid var(--color-border); flex-shrink: 0;
  }
  .ae-split { display: flex; flex: 1; min-height: 0; overflow: hidden; }
  .ae-pane { flex: 1; display: flex; flex-direction: column; min-width: 0; }
  .ae-pane-left { border-right: 1px solid var(--color-border); }
  .ae-pane-label {
    font-size: 0.72rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--color-text-muted);
    padding: 0.5rem 1.2rem; flex-shrink: 0;
    border-bottom: 1px solid var(--color-border);
  }
  .ae-toolbar {
    display: flex; gap: 0.3rem; padding: 0.4rem 1.2rem;
    border-bottom: 1px solid var(--color-border); flex-shrink: 0;
  }
  .ae-toolbar button {
    padding: 0.3rem 0.55rem; border: 1px solid var(--color-border);
    border-radius: 5px; background: var(--color-bg); color: var(--color-text-muted);
    cursor: pointer; font-size: 0.78rem; font-family: inherit;
    display: flex; align-items: center; gap: 0.25rem; transition: all 0.15s;
  }
  .ae-toolbar button:hover { background: var(--color-border); color: var(--color-text); }
  .ae-pane-content { flex: 1; overflow-y: auto; padding: 1.2rem; }
  .ae-pane-content textarea {
    width: 100%; height: 100%; border: none; outline: none; resize: none;
    font-family: var(--font-mono); font-size: 0.92rem; line-height: 1.75;
    background: var(--color-bg); color: var(--color-text);
  }
  .ae-pane-content textarea::placeholder { color: var(--color-text-muted); opacity: 0.5; }

  .ae-bottom-bar {
    display: flex; align-items: center; gap: 1rem;
    padding: 0.8rem 1.5rem; border-top: 1px solid var(--color-border);
    flex-shrink: 0; flex-wrap: wrap;
  }
  .ae-opt-group { display: flex; align-items: center; gap: 0.4rem; }
  .ae-bottom-bar label { font-size: 0.78rem; font-weight: 600; color: var(--color-text-muted); white-space: nowrap; }
  .ae-bottom-bar input[type="text"] {
    padding: 0.4rem 0.55rem; border: 1px solid var(--color-border);
    border-radius: 6px; font-size: 0.82rem; background: var(--color-bg); color: var(--color-text);
    font-family: inherit; width: 110px;
  }
  .ae-bottom-bar input[type="text"]:focus { outline: none; border-color: var(--color-accent); }
  .ae-checkbox {
    display: flex; align-items: center; gap: 0.35rem; cursor: pointer;
    font-size: 0.78rem; color: var(--color-text-muted); user-select: none;
  }
  .ae-checkbox input[type="checkbox"] {
    appearance: none; -webkit-appearance: none;
    width: 17px; height: 17px; border: 2px solid var(--color-border);
    border-radius: 4px; cursor: pointer; position: relative; transition: all 0.15s;
  }
  .ae-checkbox input[type="checkbox"]:checked { background: var(--color-accent); border-color: var(--color-accent); }
  .ae-checkbox input[type="checkbox"]:checked::after {
    content: ""; position: absolute; left: 4px; top: 1px; width: 5px; height: 9px;
    border: solid #fff; border-width: 0 2px 2px 0; transform: rotate(45deg);
  }

  /* ===== Preview in editor ===== */
  .ae-preview { font-size: 0.95rem; line-height: 1.8; word-break: break-word; }
  .ae-preview h1 { font-size: 1.5rem; font-weight: 700; margin: 0 0 1rem; line-height: 1.3; letter-spacing: -0.02em; }
  .ae-preview h2 { font-size: 1.2rem; font-weight: 700; margin: 2rem 0 0.8rem; line-height: 1.3; }
  .ae-preview h3 { font-size: 1.05rem; font-weight: 700; margin: 1.5rem 0 0.6rem; }
  .ae-preview p { margin: 0.8rem 0; }
  .ae-preview ul, .ae-preview ol { padding-left: 1.5rem; margin: 0.8rem 0; }
  .ae-preview li { margin: 0.2rem 0; }
  .ae-preview strong { font-weight: 700; }
  .ae-preview blockquote:not(.callout) {
    border-left: 3px solid var(--color-accent); padding: 0.4rem 1rem;
    margin: 1rem 0; color: var(--color-text-muted); font-style: italic;
  }
  .ae-preview code {
    font-family: var(--font-mono); font-size: 0.88em;
    background: #f0efed; padding: 0.15em 0.35em; border-radius: 3px;
  }
  .ae-preview pre {
    background: #1c1917; color: #fafaf9; padding: 1rem 1.2rem; border-radius: 6px;
    overflow-x: auto; margin: 1rem 0; font-size: 0.85rem; line-height: 1.6;
  }
  .ae-preview pre code { background: none; padding: 0; }
  .ae-preview mark { background: #fde68a; color: inherit; padding: 0.1em 0.2em; border-radius: 2px; }
  .ae-preview hr { border: none; border-top: 1px solid var(--color-border); margin: 2rem 0; }
  .ae-preview a { color: var(--color-accent); text-decoration: none; }
  .ae-preview table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
  .ae-preview th, .ae-preview td { border: 1px solid var(--color-border); padding: 0.4rem 0.7rem; text-align: left; font-size: 0.88rem; }
  .ae-preview th { background: #f5f5f4; font-weight: 600; }
  .ae-preview img { max-width: 100%; border-radius: 4px; }
  .ae-preview .callout {
    border-left: 4px solid var(--color-accent); border-radius: 0 6px 6px 0;
    padding: 0.8rem 1rem; margin: 1rem 0; font-style: normal;
  }
  .ae-preview .callout-title { font-weight: 700; font-size: 0.82rem; letter-spacing: 0.05em; color: var(--color-text-muted); margin-bottom: 0.3rem; display: block; }
  .ae-preview .callout-note { background: var(--color-callout-note); border-color: #0284c7; }
  .ae-preview .callout-warning { background: var(--color-callout-warning); border-color: #d97706; }
  .ae-preview .callout-tip { background: var(--color-callout-tip); border-color: #16a34a; }
  .ae-preview .callout-info { background: var(--color-callout-info); border-color: #2563eb; }
  .ae-preview .callout-danger { background: #fee2e2; border-color: #dc2626; }

  /* Link card in preview */
  .ae-preview .link-card {
    display: flex; align-items: stretch; border: 1px solid var(--color-border);
    border-radius: 10px; margin: 1rem 0; text-decoration: none; overflow: hidden;
  }
  .ae-preview .link-card:hover { border-color: var(--color-accent); }
  .ae-preview .link-card-thumb {
    width: 100px; min-height: 80px; flex-shrink: 0;
    background: var(--color-border); position: relative; overflow: hidden;
  }
  .ae-preview .link-card-thumb img {
    width: 100%; height: 100%; object-fit: cover; position: absolute; top: 0; left: 0;
  }
  .ae-preview .link-card-body {
    flex: 1; min-width: 0; padding: 0.75rem 0.9rem;
    display: flex; flex-direction: column; justify-content: center; gap: 0.3rem;
  }
  .ae-preview .link-card-body strong {
    display: block; font-size: 0.88rem; line-height: 1.4; color: var(--color-text);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .ae-preview .link-card-body .link-card-desc {
    font-size: 0.76rem; color: var(--color-text-muted);
    display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;
  }
  .ae-preview .link-card-body .link-card-domain { font-size: 0.7rem; color: var(--color-text-muted); opacity: 0.7; }

  /* Apple Music */
  .ae-preview .apple-music-embed {
    border-radius: 12px; overflow: hidden; margin: 1rem 0;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
  }
  .ae-preview .apple-music-embed iframe { width: 100%; height: 175px; border: none; }

  /* Toast */
  .auth-toast {
    position: fixed; bottom: 2.5rem; left: 50%; transform: translateX(-50%) translateY(1rem);
    padding: 0.75rem 1.5rem; border-radius: 10px; font-size: 0.9rem;
    background: #1c1917; color: #fafaf9; z-index: 9999;
    opacity: 0; transition: all 0.25s ease; pointer-events: none;
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
  }
  .auth-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
  .auth-toast.error { background: #dc2626; }
  .auth-toast.success { background: #16a34a; }
  .auth-toast a { color: #fff; text-decoration: underline; }

  @media (prefers-color-scheme: dark) {
    .ae-preview code { background: #292524; }
    .ae-preview th { background: #292524; }
    .ae-preview .callout-danger { background: #450a0a; }
  }

  @media (max-width: 768px) {
    .ae-split { flex-direction: column; }
    .ae-pane-left { border-right: none; border-bottom: 1px solid var(--color-border); flex: 1 1 55%; }
    .ae-pane-left .ae-pane-content textarea { min-height: 200px; }
    .ae-pane:last-child { flex: 1 1 45%; }
    .ae-bottom-bar { gap: 0.6rem; padding: 0.6rem 1rem; }
    .ae-bottom-bar input[type="text"] { width: 90px; }
  }
</style>

<script>
  import { marked } from "marked";

  const TK = "publish_token";
  const REPO = "UsephJo/usephjo.github.io";
  const CONTENT_PATH = "src/content/posts";
  const DRAFT_KEY = "publish_draft";
  const DRAFT_CATS_KEY = "publish_draft_cats";
  const DRAFT_TAGS_KEY = "publish_draft_tags";
  const DRAFT_RSS_KEY = "publish_draft_rss";

  // Build-time posts data
  const postsEl = document.getElementById("posts-data");
  const ALL_POSTS: Array<{
    id: string; title: string; date: string;
    categories: string[]; tags: string[]; rss: boolean; slug: string;
  }> = postsEl ? JSON.parse(postsEl.textContent || "[]") : [];

  // State containers
  const $setup = document.getElementById("auth-setup")!;
  const $dashboard = document.getElementById("auth-dashboard")!;
  const $editorOverlay = document.getElementById("auth-editor-overlay")!;
  const $postList = document.getElementById("post-list")!;

  // Setup
  const $tokenInput = document.getElementById("token-input") as HTMLInputElement;
  const $btnSave = document.getElementById("btn-save")!;
  const $tokenError = document.getElementById("token-error")!;

  // Dashboard
  const $btnNewPostSidebar = document.getElementById("btn-new-post-sidebar")!;
  const $btnLogout = document.getElementById("btn-logout")!;

  // Editor
  const $btnCloseEditor = document.getElementById("btn-close-editor")!;
  const $content = document.getElementById("content-area") as HTMLTextAreaElement;
  const $preview = document.getElementById("preview")!;
  const $categories = document.getElementById("categories-input") as HTMLInputElement;
  const $tags = document.getElementById("tags-input") as HTMLInputElement;
  const $rssCheck = document.getElementById("rss-check") as HTMLInputElement;
  const $btnPublish = document.getElementById("btn-publish") as HTMLButtonElement;
  const $charCount = document.getElementById("char-count")!;
  const $editorFilename = document.getElementById("editor-filename")!;
  const $editorModeLabel = document.getElementById("editor-mode-label")!;
  const $fileInput = document.getElementById("file-input") as HTMLInputElement;
  const $btnImage = document.getElementById("btn-image")!;
  const $btnLinkCard = document.getElementById("btn-link-card")!;
  const $toast = document.getElementById("toast")!;

  let toastTimer: ReturnType<typeof setTimeout>;
  let publishing = false;
  let editingFile: { filename: string; sha: string } | null = null;

  // ===== State =====
  function showState(state: "setup" | "dashboard" | "editor") {
    $setup.style.display = state === "setup" ? "" : "none";
    $dashboard.style.display = state === "dashboard" ? "" : "none";
    $editorOverlay.style.display = state === "editor" ? "" : "none";
  }

  function hasToken() { return !!localStorage.getItem(TK); }

  // ===== Toast =====
  function toast(text: string, type?: string) {
    clearTimeout(toastTimer);
    $toast.className = "auth-toast " + (type ?? "");
    $toast.innerHTML = text;
    requestAnimationFrame(() => $toast.classList.add("show"));
    toastTimer = setTimeout(() => $toast.classList.remove("show"), 3000);
  }

  // ===== Setup → Dashboard =====
  $btnSave.addEventListener("click", () => {
    const t = $tokenInput.value.trim();
    if (!t) { $tokenError.style.display = "block"; $tokenError.textContent = "请输入令牌"; return; }
    localStorage.setItem(TK, t);
    $tokenError.style.display = "none";
    showState("dashboard");
  });
  $tokenInput.addEventListener("keydown", (e) => { if (e.key === "Enter") $btnSave.click(); });

  // ===== Logout =====
  $btnLogout.addEventListener("click", () => {
    if (confirm("确定清除令牌？\n（草稿会被保留）")) {
      localStorage.removeItem(TK);
      showState("setup");
      toast("令牌已清除");
    }
  });

  // ===== Open editor for new post =====
  function openNewPost() {
    editingFile = null;
    $content.value = "";
    $categories.value = "";
    $tags.value = "";
    $rssCheck.checked = true;
    $charCount.textContent = "0 字";
    $editorFilename.textContent = "";
    $editorModeLabel.textContent = "新增内容";
    $btnPublish.textContent = "发布";
    $preview.innerHTML = '<span style="color:var(--color-text-muted);font-style:italic;">在左边输入内容，这里会实时渲染……</span>';
    showState("editor");
    $content.focus();
  }

  $btnNewPostSidebar.addEventListener("click", (e) => { e.preventDefault(); openNewPost(); });

  // ===== Open editor for editing existing post =====
  async function openEditPost(filename: string) {
    const token = localStorage.getItem(TK);
    if (!token) { toast("令牌丢失，请重新登录", "error"); showState("setup"); return; }

    toast("正在加载文章...");
    try {
      const res = await fetch(
        `https://api.github.com/repos/${REPO}/contents/${CONTENT_PATH}/${filename}`,
        { headers: { Authorization: `Bearer ${token}`, Accept: "application/vnd.github+json" } }
      );
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      const raw = atob(data.content);
      const sha = data.sha;

      // Parse frontmatter
      const fmMatch = raw.match(/^---\n([\s\S]*?)\n---\n([\s\S]*)$/);
      let body = raw;
      if (fmMatch) {
        const fm = fmMatch[1];
        body = fmMatch[2].trim();
        const titleMatch = fm.match(/title:\s*"([^"]*)"/);
        const catsMatch = fm.match(/categories:\s*\[([^\]]*)\]/);
        const tagsMatch = fm.match(/tags:\s*\[([^\]]*)\]/);
        const rssMatch = fm.match(/rss:\s*(true|false)/);

        if (titleMatch) {
          // Prepend title as first line for the editor
          body = `# ${titleMatch[1]}\n\n${body}`;
        }
        if (catsMatch) {
          $categories.value = catsMatch[1].split(",").map((s: string) => s.trim()).filter(Boolean).join(", ");
        } else {
          $categories.value = "";
        }
        if (tagsMatch) {
          $tags.value = tagsMatch[1].split(",").map((s: string) => s.trim()).filter(Boolean).join(", ");
        } else {
          $tags.value = "";
        }
        if (rssMatch) {
          $rssCheck.checked = rssMatch[1] === "true";
        }
      } else {
        $categories.value = "";
        $tags.value = "";
      }

      $content.value = body;
      $charCount.textContent = `${body.length} 字`;
      editingFile = { filename, sha };
      $editorFilename.textContent = filename;
      $editorModeLabel.textContent = "编辑文章";
      $btnPublish.textContent = "更新";
      updatePreview();
      showState("editor");
      $content.focus();
      toast("文章已加载");
    } catch (e) {
      toast(`加载失败：${(e as Error).message}`, "error");
    }
  }

  // Attach edit handlers to post list buttons
  $postList.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest(".btn-edit-post") as HTMLElement | null;
    if (btn) {
      e.preventDefault();
      const filename = btn.dataset.filename;
      if (filename) openEditPost(filename);
    }
  });

  // ===== Close editor =====
  $btnCloseEditor.addEventListener("click", () => {
    if ($content.value.trim() && !confirm("返回面板将保留草稿，确定？")) return;
    saveDraft();
    showState("dashboard");
  });

  // ===== Cursor helper =====
  function insertAtCursor(text: string) {
    const start = $content.selectionStart;
    const end = $content.selectionEnd;
    $content.value = $content.value.slice(0, start) + text + $content.value.slice(end);
    $content.selectionStart = $content.selectionEnd = start + text.length;
    $content.focus();
    $content.dispatchEvent(new Event("input"));
  }

  // ===== Image upload =====
  $btnImage.addEventListener("click", () => $fileInput.click());
  $fileInput.addEventListener("change", () => {
    const files = $fileInput.files;
    if (!files || files.length === 0) return;
    toast(`正在处理 ${files.length} 张图片...`);
    let done = 0;
    for (const file of Array.from(files)) {
      const reader = new FileReader();
      reader.onload = () => {
        insertAtCursor(`\n![${file.name.replace(/\.[^.]+$/, "")}](${reader.result as string})\n`);
        done++;
        if (done === files.length) toast(`${done} 张图片已插入`, "success");
      };
      reader.onerror = () => toast(`读取 ${file.name} 失败`, "error");
      reader.readAsDataURL(file);
    }
    $fileInput.value = "";
  });

  // ===== Image paste =====
  $content.addEventListener("paste", (e: ClipboardEvent) => {
    const items = e.clipboardData?.items;
    if (!items) return;
    for (const item of Array.from(items)) {
      if (item.type.startsWith("image/")) {
        e.preventDefault();
        const file = item.getAsFile();
        if (!file) continue;
        const reader = new FileReader();
        reader.onload = () => { insertAtCursor(`\n![image](${reader.result as string})\n`); toast("图片已插入"); };
        reader.readAsDataURL(file);
        return;
      }
    }
  });

  // ===== Link card =====
  const URL_RE = /https?:\/\/[^\s<>"']+/gi;

  function extractDomain(url: string): string {
    try { return new URL(url).hostname.replace(/^www\./, ""); } catch { return url; }
  }

  function buildLinkCardHTML(url: string, meta?: { title?: string; desc?: string; image?: string }): string {
    const domain = extractDomain(url);
    const displayTitle = meta?.title || domain;
    const displayDesc = meta?.desc || "";
    const thumbHTML = meta?.image
      ? `<span class="link-card-thumb"><img src="${meta.image}" alt="" onerror="this.parentElement.style.display='none'" /></span>`
      : "";
    const descHTML = displayDesc ? `<span class="link-card-desc">${displayDesc}</span>` : "";
    return `<a href="${url}" target="_blank" rel="noopener" class="link-card">${thumbHTML}<span class="link-card-body"><strong>${displayTitle}</strong>${descHTML}<span class="link-card-domain">${domain}</span></span></a>`;
  }

  async function tryFetchMetadata(url: string) {
    try {
      const ctrl = new AbortController();
      const t = setTimeout(() => ctrl.abort(), 4000);
      const res = await fetch(url, { signal: ctrl.signal });
      clearTimeout(t);
      if (!res.ok) return null;
      const html = await res.text();
      return {
        title: (html.match(/<meta\s+property="og:title"\s+content="([^"]+)"/i) || [])[1]
          || (html.match(/<title[^>]*>([^<]+)<\/title>/i) || [])[1]?.trim(),
        desc: (html.match(/<meta\s+property="og:description"\s+content="([^"]+)"/i) || [])[1]
          || (html.match(/<meta\s+name="description"\s+content="([^"]+)"/i) || [])[1],
        image: (html.match(/<meta\s+property="og:image"\s+content="([^"]+)"/i) || [])[1],
      };
    } catch { return null; }
  }

  async function insertLinkCard(url: string) {
    toast("正在获取页面信息...");
    const meta = await tryFetchMetadata(url);
    insertAtCursor(`\n${buildLinkCardHTML(url, meta || undefined)}\n\n`);
    toast(meta?.title ? "链接卡片已插入" : `已插入链接卡片（${extractDomain(url)}）`, "success");
  }

  $btnLinkCard.addEventListener("click", () => {
    const url = prompt("粘贴网页链接：");
    if (url && URL_RE.test(url.trim())) insertLinkCard(url.trim());
    else if (url) toast("请输入有效的 URL", "error");
  });

  // Apple Music detection
  function detectAppleMusicEmbed(text: string): { html: string } | null {
    const iframeMatch = text.match(/<iframe[^>]*src="(https:\/\/embed\.music\.apple\.com\/[^"]*)"[^>]*><\/iframe>/i);
    if (iframeMatch) {
      return { html: `<div class="apple-music-embed"><iframe allow="autoplay *; encrypted-media *;" frameborder="0" sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-storage-access-by-user-activation allow-top-navigation-by-user-activation" src="${iframeMatch[1]}"></iframe></div>` };
    }
    const shareMatch = text.match(/https:\/\/music\.apple\.com\/\S+/i);
    if (shareMatch) {
      return { html: `<div class="apple-music-embed"><iframe allow="autoplay *; encrypted-media *;" frameborder="0" sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-storage-access-by-user-activation allow-top-navigation-by-user-activation" src="${shareMatch[0].replace(/music\.apple\.com/, "embed.music.apple.com")}"></iframe></div>` };
    }
    return null;
  }

  $content.addEventListener("paste", (e: ClipboardEvent) => {
    const text = e.clipboardData?.getData("text/plain");
    if (!text?.trim()) return;
    const trimmed = text.trim();
    const am = detectAppleMusicEmbed(trimmed);
    if (am) { e.preventDefault(); insertAtCursor(`\n${am.html}\n\n`); toast("Apple Music 嵌入已插入"); return; }
    if (URL_RE.test(trimmed) && trimmed.split(/\s+/).length === 1) {
      e.preventDefault(); insertLinkCard(trimmed);
    }
  });

  // ===== Live Preview =====
  const renderer = new marked.Renderer();

  function slugify(s: string): string {
    return s.toLowerCase().replace(/[^\w一-鿿]+/g, "-").replace(/^-|-$/g, "").slice(0, 60) || "untitled";
  }

  function preprocessObsidian(md: string): string {
    let text = md;
    text = text.replace(/==([^=\n]+)==/g, "<mark>$1</mark>");
    text = text.replace(/!\[\[([^\]]+)\]\]/g, (_m: string, file: string) => `<img src="/images/${file}" alt="${file}" />`);
    text = text.replace(/\[\[([^\]|#]+)(?:#([^\]|]+))?(?:\|([^\]]+))?\]\]/g, (_m: string, page: string, _h: string, alias: string) => {
      return `[${alias || page}](/posts/${slugify(page)}/)`;
    });
    text = text.replace(/^>\s*\[!(\w+)\]\s*(.*?)\n(.*?)(?=\n(?!>)|$)/gms, (_m: string, type: string, title: string, body: string) => {
      const t = type.toLowerCase();
      const bodyClean = body.replace(/^>\s?/gm, "");
      return `<aside class="callout callout-${t}"><span class="callout-title">${title || t.toUpperCase()}</span>\n\n${bodyClean}\n\n</aside>`;
    });
    return text;
  }

  function updatePreview() {
    const raw = $content.value;
    if (!raw.trim()) {
      $preview.innerHTML = '<span style="color:var(--color-text-muted);font-style:italic;">在左边输入内容，这里会实时渲染……</span>';
      return;
    }
    try {
      $preview.innerHTML = marked.parse(preprocessObsidian(raw), { renderer, breaks: true }) as string;
    } catch (e) {
      console.error("Preview error:", e);
      $preview.innerHTML = '<span style="color:#dc2626;">预览渲染失败</span>';
    }
  }

  // ===== Draft =====
  function saveDraft() {
    localStorage.setItem(DRAFT_KEY, $content.value);
    localStorage.setItem(DRAFT_CATS_KEY, $categories.value);
    localStorage.setItem(DRAFT_TAGS_KEY, $tags.value);
    localStorage.setItem(DRAFT_RSS_KEY, String($rssCheck.checked));
  }
  function clearDraft() {
    localStorage.removeItem(DRAFT_KEY);
    localStorage.removeItem(DRAFT_CATS_KEY);
    localStorage.removeItem(DRAFT_TAGS_KEY);
    localStorage.removeItem(DRAFT_RSS_KEY);
  }

  let previewTimer: ReturnType<typeof setTimeout>;
  $content.addEventListener("input", () => {
    $charCount.textContent = `${$content.value.length} 字`;
    clearTimeout(previewTimer);
    previewTimer = setTimeout(() => { updatePreview(); saveDraft(); }, 300);
  });
  $categories.addEventListener("input", saveDraft);
  $tags.addEventListener("input", saveDraft);
  $rssCheck.addEventListener("change", saveDraft);

  // ===== Publish / Update =====
  function toBase64(str: string): string {
    const bytes = new TextEncoder().encode(str);
    let bin = "";
    for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
    return btoa(bin);
  }

  function parseTitleFromBody(raw: string): { title: string; body: string } {
    const lines = raw.split("\n");
    let title = lines[0].replace(/^#\s+/, "").trim();
    let bodyStart = 1;
    while (bodyStart < lines.length && lines[bodyStart].trim() === "") bodyStart++;
    const body = lines.slice(bodyStart).join("\n").trim();
    return { title: title || "Untitled", body };
  }

  async function publishOrUpdate() {
    if (publishing) return;
    const raw = $content.value;
    if (!raw.trim()) { toast("请输入内容", "error"); return; }

    const { title, body } = parseTitleFromBody(raw);
    if (!body) { toast("正文不能为空", "error"); return; }

    const token = localStorage.getItem(TK);
    if (!token) { toast("令牌丢失，请重新登录", "error"); showState("setup"); return; }

    const cats = $categories.value.split(",").map((s: string) => s.trim()).filter(Boolean);
    const tags = $tags.value.split(",").map((s: string) => s.trim()).filter(Boolean);
    const rss = $rssCheck.checked;

    const now = new Date();
    const dateStr = now.toISOString().split("T")[0];
    const slug = slugify(title);
    const ts = now.getTime().toString(36);
    const filename = editingFile ? editingFile.filename : `${slug}-${ts}.md`;

    const esc = (s: string) => s.replace(/"/g, '\\"');
    const catsYaml = cats.length ? `categories: [${cats.join(", ")}]` : "categories: []";
    const tagsYaml = tags.length ? `tags: [${tags.join(", ")}]` : "tags: []";
    const desc = esc(body.replace(/\n/g, " ").slice(0, 120));

    const fm = [
      "---",
      `title: "${esc(title)}"`,
      `date: ${dateStr}`,
      catsYaml,
      tagsYaml,
      `rss: ${rss}`,
      `description: "${desc}"`,
      "---",
      "",
      body,
      "",
    ].join("\n");

    const isUpdate = !!editingFile;
    publishing = true;
    $btnPublish.disabled = true;
    $btnPublish.textContent = isUpdate ? "更新中..." : "发布中...";

    try {
      const bodyObj: Record<string, unknown> = {
        message: `${isUpdate ? "更新" : "发布"}: ${title}`,
        content: toBase64(fm),
      };
      if (editingFile?.sha) bodyObj.sha = editingFile.sha;

      const res = await fetch(
        `https://api.github.com/repos/${REPO}/contents/${CONTENT_PATH}/${filename}`,
        {
          method: "PUT",
          headers: {
            Authorization: `Bearer ${token}`,
            "Content-Type": "application/json",
            Accept: "application/vnd.github+json",
          },
          body: JSON.stringify(bodyObj),
        }
      );

      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        const status = res.status;
        if (status === 401) throw new Error("令牌无效或已过期，请重新设置");
        if (status === 403) throw new Error("令牌权限不足，创建时需勾选 repo 权限");
        if (status === 409) throw new Error("文件已被其他人修改，请刷新后重试");
        throw new Error((err as any).message || `HTTP ${status}`);
      }

      const updatedData = await res.json();
      // Update sha for subsequent edits
      if (updatedData.content?.sha) {
        editingFile = { filename, sha: updatedData.content.sha };
      }

      toast(
        isUpdate
          ? `已更新！稍后访问 <a href="/posts/${slug}/">/${slug}/</a>`
          : `已发布！稍后访问 <a href="/posts/${slug}-${ts}/">/${slug}-${ts}</a>`,
        "success"
      );

      // Update post list entry
      if (isUpdate) {
        updatePostInList(filename, title, dateStr, cats, tags, rss, slug);
      } else {
        addPostToList(filename, title, dateStr, cats, tags, rss, slug, ts);
      }

      // Reset editor for new post mode; stay in editor for edit mode
      if (!isUpdate) {
        $content.value = "";
        $preview.innerHTML = '<span style="color:var(--color-text-muted);font-style:italic;">在左边输入内容，这里会实时渲染……</span>';
        $categories.value = "";
        $tags.value = "";
        $rssCheck.checked = true;
        $charCount.textContent = "0 字";
        editingFile = null;
        $editorModeLabel.textContent = "新增内容";
        $btnPublish.textContent = "发布";
        clearDraft();
      }
      $content.focus();
    } catch (e) {
      const msg = (e as Error).message;
      if (msg.includes("令牌")) {
        toast(`发布失败：${msg}。<br/><a href="#" id="toast-reset-token" style="text-decoration:underline;">点此重新设置令牌</a>`, "error");
        setTimeout(() => {
          const link = document.getElementById("toast-reset-token");
          if (link) link.addEventListener("click", (ev) => {
            ev.preventDefault();
            localStorage.removeItem(TK);
            showState("setup");
            toast("请粘贴新的令牌");
          });
        }, 50);
      } else {
        toast(`发布失败：${msg}`, "error");
      }
    } finally {
      publishing = false;
      $btnPublish.disabled = false;
      $btnPublish.textContent = isUpdate ? "更新" : "发布";
    }
  }

  function updatePostInList(filename: string, title: string, dateStr: string, cats: string[], tags: string[], rss: boolean, slug: string) {
    const item = $postList.querySelector(`[data-filename="${CSS.escape(filename)}"]`) as HTMLElement | null;
    if (!item) return;
    const titleEl = item.querySelector(".post-item-title") as HTMLElement | null;
    const metaEl = item.querySelector(".post-item-meta");
    const viewLink = item.querySelector(".post-item-actions a") as HTMLElement | null;
    if (titleEl) titleEl.textContent = title;
    if (metaEl) {
      metaEl.innerHTML = `<time>${new Date(dateStr).toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" })}</time>${cats.length ? " · " + cats.join(", ") : ""}${!rss ? '<span style="color:var(--color-accent);"> · 未推送</span>' : ""}`;
    }
    if (viewLink) viewLink.href = `/posts/${slug}/`;
  }

  function addPostToList(filename: string, title: string, dateStr: string, cats: string[], tags: string[], rss: boolean, slug: string, ts: string) {
    const div = document.createElement("div");
    div.className = "post-item";
    div.dataset.filename = filename;
    div.innerHTML = `
      <div class="post-item-main">
        <a href="/posts/${slug}-${ts}/" class="post-item-title">${title}</a>
        <div class="post-item-meta">
          <time>${new Date(dateStr).toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" })}</time>
          ${cats.length ? " · " + cats.join(", ") : ""}
          ${!rss ? '<span style="color:var(--color-accent);"> · 未推送</span>' : ""}
        </div>
      </div>
      <div class="post-item-actions">
        <button class="btn-edit-post auth-btn-sm" data-filename="${filename}">编辑</button>
        <a href="/posts/${slug}-${ts}/" class="auth-btn-sm" style="color:var(--color-text-muted);text-decoration:none;">查看</a>
      </div>`;
    $postList.insertBefore(div, $postList.firstChild);
    // Remove empty state if exists
    const emptyMsg = $postList.querySelector("p");
    if (emptyMsg) emptyMsg.remove();
  }

  $btnPublish.addEventListener("click", publishOrUpdate);

  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === "Enter") {
      e.preventDefault();
      if (hasToken() && $editorOverlay.style.display !== "none") publishOrUpdate();
    }
  });

  // ===== Init =====
  if (hasToken()) {
    showState("dashboard");
  } else {
    showState("setup");
  }
</script>
