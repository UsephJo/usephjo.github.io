---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts");
const postsData = posts.map((p) => ({
  id: p.id,
  title: p.data.title,
  date: p.data.date.toISOString(),
  categories: p.data.categories ?? [],
  tags: p.data.tags ?? [],
  rss: p.data.rss,
  draft: p.data.draft ?? false,
  slug: p.id.replace(/\.md$/, ""),
}));
---

<BaseLayout title="管理">
  <div id="auth-root">
    <!-- State A: Token Setup -->
    <div id="auth-setup" class="auth-state auth-setup">
      <div class="auth-setup-card">
        <h1 class="auth-setup-title">登录</h1>
        <p class="auth-setup-desc">
          使用 GitHub 令牌验证身份。令牌仅保存在你的浏览器中。
        </p>

        <div class="auth-setup-steps">
          <a href="https://github.com/settings/tokens/new?scopes=repo&description=blog-publish" target="_blank" class="auth-setup-link">
            <span class="auth-setup-step-label">创建令牌</span>
            <span class="auth-setup-step-hint">打开 GitHub，点 Generate token</span>
          </a>

          <div class="auth-setup-field">
            <span class="auth-setup-step-label">粘贴令牌</span>
            <input id="token-input" type="password" placeholder="ghp_..." autocomplete="off" />
            <span class="auth-setup-step-hint">创建后仅显示一次，请立即复制</span>
          </div>
        </div>

        <button id="btn-save" class="auth-setup-btn">验证并进入</button>
        <p id="token-error" class="auth-setup-error" style="display:none;"></p>
        <p id="token-verifying" class="auth-setup-verifying" style="display:none;">验证中...</p>

        <details class="auth-setup-details">
          <summary>找不到之前的令牌？</summary>
          <p>
            GitHub 不显示已创建的令牌。丢失后重新创建即可，旧令牌自动失效。
            <a href="https://github.com/settings/tokens" target="_blank">管理令牌 →</a>
          </p>
        </details>
      </div>
    </div>

    <!-- State B: Dashboard -->
    <div id="auth-dashboard" class="auth-state" style="display:none;">
      <div class="page-layout">
        <main class="main-content">
          <div class="db-header">
            <h2>文章管理</h2>
          </div>
          <div id="post-list">
            {postsData.length === 0 ? (
              <p class="empty-state">还没有文章，点击右侧「新增内容」开始写作。</p>
            ) : (
              postsData.map((post) => (
                <div class="post-item" data-filename={post.id}>
                  <div class="post-item-main">
                    <a href={`/posts/${post.slug}/`} class="post-item-title">{post.title}</a>
                    <div class="post-item-meta">
                      <time>{new Date(post.date).toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" }) + " " + new Date(post.date).toLocaleTimeString("zh-CN", { hour: "2-digit", minute: "2-digit" })}</time>
                      {post.draft && <span class="draft-badge"> · 私密</span>}
                      {post.categories.length > 0 && (
                        <span> · {post.categories.join(", ")}</span>
                      )}
                      {!post.rss && <span class="rss-badge"> · 未推送</span>}
                    </div>
                  </div>
                  <div class="post-item-actions">
                    <button class="btn-edit-post auth-btn-sm" data-filename={post.id}>编辑</button>
                    <a href={`/posts/${post.slug}/`} class="post-item-link">查看</a>
                  </div>
                </div>
              ))
            )}
          </div>
        </main>
        <aside class="sidebar">
          <div class="sidebar-section">
            <h3>操作</h3>
            <ul>
              <li><a href="#" id="btn-new-post-sidebar">+ 新增内容</a></li>
              <li><a href="/" class="muted-link">← 返回首页</a></li>
            </ul>
          </div>
          <div class="sidebar-section">
            <h3>站点设置</h3>
            <div class="settings-fields">
              <label>博客名</label>
              <input id="setting-title" type="text" placeholder="usephjo's blog" />
              <label>域名</label>
              <input id="setting-url" type="text" placeholder="https://usephjo.github.io" />
              <label>作者</label>
              <input id="setting-author" type="text" placeholder="usephjo" />
              <button id="btn-save-settings" class="auth-btn-sm" style="margin-top:0.5rem;">保存设置</button>
            </div>
          </div>
          <div class="sidebar-section">
            <h3>账号</h3>
            <ul>
              <li><a href="#" id="btn-logout" class="muted-link">退出登录</a></li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </div>

  <!-- State C: Editor Overlay -->
  <div id="auth-editor-overlay" class="ae-overlay" style="display:none;">
    <div id="auth-editor" class="ae-container">
      <div class="ae-top-bar">
        <div class="ae-top-bar-left">
          <button id="btn-close-editor" class="auth-btn-ghost">&larr; 返回</button>
          <span id="editor-mode-label" class="ae-mode-label">写点什么</span>
        </div>
        <span id="editor-filename" class="ae-filename"></span>
      </div>
      <div class="ae-split">
        <div class="ae-pane ae-pane-left">
          <div class="ae-pane-label">Markdown</div>
          <div class="ae-toolbar">
            <button id="btn-image" title="上传图片"><span>&#128247;</span> 图片</button>
            <button id="btn-link-card" title="粘贴链接生成卡片"><span>&#128279;</span> 链接卡片</button>
          </div>
          <div class="ae-pane-content">
            <textarea id="content-area" placeholder="第一行是标题&#10;空一行&#10;开始写正文..."></textarea>
          </div>
          <input type="file" id="file-input" accept="image/*" style="display:none" multiple />
        </div>
        <div class="ae-pane">
          <div class="ae-pane-label">预览</div>
          <div class="ae-pane-content">
            <div id="preview" class="ae-preview ae-placeholder">在左边输入内容，这里会实时渲染……</div>
          </div>
        </div>
      </div>
      <div class="ae-bottom-bar">
        <div class="ae-opt-group">
          <label for="categories-input">分类</label>
          <input id="categories-input" type="text" placeholder="tech, life" />
        </div>
        <div class="ae-opt-group">
          <label for="tags-input">标签</label>
          <input id="tags-input" type="text" placeholder="astro, blog" />
        </div>
        <div class="ae-spacer"></div>
        <label class="ae-checkbox" title="勾选后仅登录用户可见">
          <input type="checkbox" id="draft-check" />
          <span>私密</span>
        </label>
        <label class="ae-checkbox" title="取消勾选后不出现在 RSS 中">
          <input type="checkbox" id="rss-check" checked />
          <span>推送到 RSS</span>
        </label>
        <button id="btn-publish" class="auth-btn-publish">发布</button>
        <span class="ae-kbd-wrap"><kbd>&#8984;</kbd> <kbd>Enter</kbd></span>
        <span id="char-count" class="ae-char-count">0 字</span>
      </div>
    </div>
  </div>

  <div id="toast" class="auth-toast"></div>

<div id="posts-data" style="display:none" data-posts={JSON.stringify(postsData)}></div>

<style is:global>
  /* ===== Login / Setup ===== */
  .auth-setup {
    display: flex; align-items: flex-start; justify-content: center;
    padding-top: 5rem; min-height: 60vh;
  }
  .auth-setup-card {
    max-width: 400px; width: 100%;
    padding: 2.5rem 2rem;
  }
  .auth-setup-title {
    font-size: 1.5rem; font-weight: 700; margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }
  .auth-setup-desc {
    font-size: 0.88rem; color: var(--color-text-muted);
    line-height: 1.6; margin: 0 0 2rem;
  }
  .auth-setup-steps {
    display: flex; flex-direction: column; gap: 1.25rem;
    margin-bottom: 1.5rem;
  }
  .auth-setup-link {
    display: block; padding: 0.9rem 1rem;
    border: 1px solid var(--color-border); border-radius: 8px;
    text-decoration: none; color: inherit; transition: border-color 0.15s;
  }
  .auth-setup-link:hover { border-color: var(--color-accent); text-decoration: none; }
  .auth-setup-field {
    padding: 0.9rem 1rem;
    border: 1px solid var(--color-border); border-radius: 8px;
  }
  .auth-setup-step-label {
    display: block; font-size: 0.82rem; font-weight: 600;
    color: var(--color-text); margin-bottom: 0.5rem;
  }
  .auth-setup-field input {
    width: 100%; border: none; outline: none;
    font-size: 0.95rem; font-family: var(--font-mono);
    background: transparent; color: var(--color-text);
    padding: 0; margin-bottom: 0.35rem;
  }
  .auth-setup-field input::placeholder { color: var(--color-text-muted); opacity: 0.4; }
  .auth-setup-step-hint {
    display: block; font-size: 0.75rem; color: var(--color-text-muted);
    opacity: 0.65;
  }
  .auth-setup-btn {
    width: 100%; padding: 0.75rem 0;
    background: var(--color-text); color: var(--color-bg);
    border: none; border-radius: 8px;
    font-size: 0.92rem; font-weight: 600; cursor: pointer;
    font-family: inherit; transition: opacity 0.15s;
  }
  .auth-setup-btn:hover { opacity: 0.85; }
  .auth-setup-btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .auth-setup-error {
    margin-top: 0.75rem; font-size: 0.82rem; color: #dc2626;
  }
  .auth-setup-verifying {
    margin-top: 0.75rem; font-size: 0.82rem; color: var(--color-text-muted);
  }
  .auth-setup-details {
    margin-top: 1.5rem; font-size: 0.78rem; color: var(--color-text-muted);
    border-top: 1px solid var(--color-border); padding-top: 1rem;
  }
  .auth-setup-details summary {
    cursor: pointer; opacity: 0.6; transition: opacity 0.15s;
  }
  .auth-setup-details summary:hover { opacity: 1; }
  .auth-setup-details p {
    margin-top: 0.6rem; line-height: 1.6;
  }
  .auth-setup-details a { color: var(--color-accent); }

  /* ===== Auth shared ===== */
  .auth-btn-ghost {
    background: transparent; color: var(--color-text-muted);
    border: 1px solid var(--color-border); font-weight: 500;
    font-size: 0.82rem; padding: 0.4rem 0.8rem; border-radius: 6px;
    cursor: pointer; font-family: inherit;
  }
  .auth-btn-ghost:hover { background: var(--color-border); }
  .auth-btn-sm {
    padding: 0.25rem 0.6rem; border: 1px solid var(--color-border);
    border-radius: 5px; background: var(--color-bg); color: var(--color-text-muted);
    cursor: pointer; font-size: 0.76rem; font-family: inherit;
    transition: all 0.15s; text-decoration: none; display: inline-block;
  }
  .auth-btn-sm:hover { background: var(--color-border); color: var(--color-text); }
  .auth-btn-publish {
    padding: 0.5rem 1.4rem; background: var(--color-text); color: var(--color-bg);
    border: none; border-radius: 8px; font-size: 0.9rem; font-weight: 600;
    cursor: pointer; font-family: inherit; transition: all 0.15s;
  }
  .auth-btn-publish:hover { opacity: 0.85; }
  .auth-btn-publish:disabled { opacity: 0.4; cursor: not-allowed; }

  /* ===== Settings panel ===== */
  .settings-fields { display: flex; flex-direction: column; gap: 0.4rem; margin-top: 0.3rem; }
  .settings-fields label { font-size: 0.72rem; font-weight: 600; color: var(--color-text-muted); }
  .settings-fields input {
    padding: 0.4rem 0.55rem; border: 1px solid var(--color-border);
    border-radius: 6px; font-size: 0.8rem; background: var(--color-bg); color: var(--color-text);
    font-family: inherit;
  }
  .settings-fields input:focus { outline: none; border-color: var(--color-accent); }

  /* ===== Post list items ===== */
  .db-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 1.5rem;
  }
  .db-header h2 { margin: 0; font-size: 1.2rem; }
  .post-item {
    display: flex; align-items: center; justify-content: space-between;
    padding: 0.9rem 0; border-bottom: 1px solid var(--color-border);
    gap: 1rem;
  }
  .post-item:last-child { border-bottom: none; }
  .post-item-main { flex: 1; min-width: 0; }
  .post-item-title {
    font-size: 1rem; font-weight: 600; color: var(--color-text); text-decoration: none;
  }
  .post-item-title:hover { color: var(--color-accent); }
  .post-item-meta {
    font-size: 0.78rem; color: var(--color-text-muted); margin-top: 0.2rem;
  }
  .post-item-actions { display: flex; gap: 0.4rem; flex-shrink: 0; }
  .post-item-link {
    padding: 0.25rem 0.6rem; border: 1px solid var(--color-border);
    border-radius: 5px; color: var(--color-text-muted); text-decoration: none;
    font-size: 0.76rem; transition: all 0.15s; display: inline-block;
  }
  .post-item-link:hover { background: var(--color-border); color: var(--color-text); }
  .muted-link { color: var(--color-text-muted); }
  .muted-link:hover { color: var(--color-text); text-decoration: none; }

  /* ===== Editor overlay ===== */
  .ae-overlay { position: fixed; inset: 0; z-index: 1000; background: var(--color-bg); }
  .ae-container { display: flex; flex-direction: column; height: 100%; }
  .ae-top-bar {
    display: flex; align-items: center; justify-content: space-between;
    padding: 0.8rem 1.5rem; border-bottom: 1px solid var(--color-border); flex-shrink: 0;
  }
  .ae-top-bar-left { display: flex; align-items: center; gap: 1rem; }
  .ae-mode-label { font-size: 0.9rem; font-weight: 600; color: var(--color-text-muted); }
  .ae-filename { font-size: 0.75rem; color: var(--color-text-muted); }
  .ae-split { display: flex; flex: 1; min-height: 0; overflow: hidden; }
  .ae-pane { flex: 1; display: flex; flex-direction: column; min-width: 0; }
  .ae-pane-left { border-right: 1px solid var(--color-border); }
  .ae-pane-label {
    font-size: 0.72rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--color-text-muted);
    padding: 0.5rem 1.2rem; flex-shrink: 0;
  }
  .ae-toolbar {
    display: flex; gap: 0.3rem; padding: 0.5rem 1.2rem;
    flex-shrink: 0;
  }
  .ae-toolbar button {
    padding: 0.3rem 0.55rem; border: 1px solid var(--color-border);
    border-radius: 5px; background: var(--color-bg); color: var(--color-text-muted);
    cursor: pointer; font-size: 0.78rem; font-family: inherit;
    display: flex; align-items: center; gap: 0.25rem; transition: all 0.15s;
  }
  .ae-toolbar button:hover { background: var(--color-border); color: var(--color-text); }
  .ae-pane-content { flex: 1; overflow-y: auto; padding: 1.2rem; }
  .ae-pane-content textarea {
    width: 100%; height: 100%; border: none; outline: none; resize: none;
    font-family: var(--font-mono); font-size: 0.92rem; line-height: 1.75;
    background: var(--color-bg); color: var(--color-text);
  }
  .ae-pane-content textarea::placeholder { color: var(--color-text-muted); opacity: 0.5; }
  .ae-placeholder { color: var(--color-text-muted); font-style: italic; }
  .ae-spacer { flex: 1; }
  .ae-kbd-wrap { font-size: 0.78rem; color: var(--color-text-muted); }
  .ae-kbd-wrap kbd {
    background: var(--color-border); padding: 0.12em 0.45em;
    border-radius: 4px; font-size: 0.88em; font-family: var(--font-mono);
  }
  .ae-char-count { font-size: 0.78rem; color: var(--color-text-muted); }

  .ae-bottom-bar {
    display: flex; align-items: center; gap: 1rem;
    padding: 0.8rem 1.5rem; border-top: 1px solid var(--color-border);
    flex-shrink: 0; flex-wrap: wrap;
  }
  .ae-opt-group { display: flex; align-items: center; gap: 0.4rem; }
  .ae-bottom-bar label { font-size: 0.78rem; font-weight: 600; color: var(--color-text-muted); white-space: nowrap; }
  .ae-bottom-bar input[type="text"] {
    padding: 0.4rem 0.55rem; border: 1px solid var(--color-border);
    border-radius: 6px; font-size: 0.82rem; background: var(--color-bg); color: var(--color-text);
    font-family: inherit; width: 110px;
  }
  .ae-bottom-bar input[type="text"]:focus { outline: none; border-color: var(--color-accent); }
  .ae-checkbox {
    display: flex; align-items: center; gap: 0.35rem; cursor: pointer;
    font-size: 0.78rem; color: var(--color-text-muted); user-select: none;
  }
  .ae-checkbox input[type="checkbox"] {
    appearance: none; -webkit-appearance: none;
    width: 17px; height: 17px; border: 2px solid var(--color-border);
    border-radius: 4px; cursor: pointer; position: relative; transition: all 0.15s;
  }
  .ae-checkbox input[type="checkbox"]:checked { background: var(--color-accent); border-color: var(--color-accent); }
  .ae-checkbox input[type="checkbox"]:checked::after {
    content: ""; position: absolute; left: 4px; top: 1px; width: 5px; height: 9px;
    border: solid #fff; border-width: 0 2px 2px 0; transform: rotate(45deg);
  }

  /* ===== Preview in editor ===== */
  .ae-preview { font-size: 0.95rem; line-height: 1.8; word-break: break-word; }
  .ae-preview h1 { font-size: 1.5rem; font-weight: 700; margin: 0 0 1rem; line-height: 1.3; letter-spacing: -0.02em; }
  .ae-preview h2 { font-size: 1.2rem; font-weight: 700; margin: 2rem 0 0.8rem; line-height: 1.3; }
  .ae-preview h3 { font-size: 1.05rem; font-weight: 700; margin: 1.5rem 0 0.6rem; }
  .ae-preview p { margin: 0.8rem 0; }
  .ae-preview ul, .ae-preview ol { padding-left: 1.5rem; margin: 0.8rem 0; }
  .ae-preview li { margin: 0.2rem 0; }
  .ae-preview strong { font-weight: 700; }
  .ae-preview blockquote:not(.callout) {
    border-left: 3px solid var(--color-accent); padding: 0.4rem 1rem;
    margin: 1rem 0; color: var(--color-text-muted); font-style: italic;
  }
  .ae-preview code {
    font-family: var(--font-mono); font-size: 0.88em;
    background: var(--color-code-bg); padding: 0.15em 0.35em; border-radius: 3px;
  }
  .ae-preview pre {
    background: var(--color-code-block-bg); color: var(--color-code-block-text);
    padding: 1rem 1.2rem; border-radius: 6px;
    overflow-x: auto; margin: 1rem 0; font-size: 0.85rem; line-height: 1.6;
  }
  .ae-preview pre code { background: none; padding: 0; }
  .ae-preview mark { background: var(--color-mark-bg); color: inherit; padding: 0.1em 0.2em; border-radius: 2px; }
  .ae-preview hr { border: none; border-top: 1px solid var(--color-border); margin: 2rem 0; }
  .ae-preview a { color: var(--color-accent); text-decoration: none; }
  .ae-preview table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
  .ae-preview th, .ae-preview td { border: 1px solid var(--color-border); padding: 0.4rem 0.7rem; text-align: left; font-size: 0.88rem; }
  .ae-preview th { background: var(--color-surface); font-weight: 600; }
  .ae-preview img { max-width: 100%; border-radius: 6px; }
  .ae-preview .callout {
    border-left: 4px solid var(--color-accent); border-radius: 0 6px 6px 0;
    padding: 1rem 1.2rem; margin: 1.5rem 0; font-style: normal; background: var(--color-surface);
  }
  .ae-preview .callout-title { font-weight: 700; font-size: 0.85rem; letter-spacing: 0.05em; color: var(--color-text-muted); margin-bottom: 0.4rem; display: block; }
  .ae-preview .callout-note { background: var(--color-callout-note); border-color: #0284c7; }
  .ae-preview .callout-warning { background: var(--color-callout-warning); border-color: #d97706; }
  .ae-preview .callout-tip { background: var(--color-callout-tip); border-color: #16a34a; }
  .ae-preview .callout-info { background: var(--color-callout-info); border-color: #2563eb; }
  .ae-preview .callout-danger { background: var(--color-callout-danger); border-color: #dc2626; }
  .ae-preview .callout-quote { background: var(--color-callout-quote); border-color: #78716c; }

  /* Link card in preview */
  .ae-preview .link-card {
    display: flex; align-items: stretch; border: 1px solid var(--color-border);
    border-radius: 10px; margin: 1rem 0; text-decoration: none; overflow: hidden;
  }
  .ae-preview .link-card:hover { border-color: var(--color-accent); }
  .ae-preview .link-card-thumb {
    width: 100px; min-height: 80px; flex-shrink: 0;
    background: var(--color-border); position: relative; overflow: hidden;
  }
  .ae-preview .link-card-thumb img {
    width: 100%; height: 100%; object-fit: cover; position: absolute; top: 0; left: 0;
  }
  .ae-preview .link-card-body {
    flex: 1; min-width: 0; padding: 0.75rem 0.9rem;
    display: flex; flex-direction: column; justify-content: center; gap: 0.3rem;
  }
  .ae-preview .link-card-body strong {
    display: block; font-size: 0.88rem; line-height: 1.4; color: var(--color-text);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .ae-preview .link-card-body .link-card-desc {
    font-size: 0.76rem; color: var(--color-text-muted);
    display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;
  }
  .ae-preview .link-card-body .link-card-domain { font-size: 0.7rem; color: var(--color-text-muted); opacity: 0.7; }

  /* WeChat card */
  .ae-preview .link-card-wechat .link-card-thumb { background: var(--color-wechat) !important; }

  /* Apple Music */
  .ae-preview .apple-music-embed {
    border-radius: 12px; overflow: hidden; margin: 1rem 0;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
  }
  .ae-preview .apple-music-embed iframe { width: 100%; height: 175px; border: none; }

  /* Toast */
  .auth-toast {
    position: fixed; bottom: 2.5rem; left: 50%; transform: translateX(-50%) translateY(1rem);
    padding: 0.75rem 1.5rem; border-radius: 10px; font-size: 0.9rem;
    background: var(--color-code-block-bg); color: var(--color-code-block-text); z-index: 9999;
    opacity: 0; transition: all 0.25s ease; pointer-events: none;
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
  }
  .auth-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
  .auth-toast.error { background: var(--color-danger); }
  .auth-toast.success { background: var(--color-success); }
  .auth-toast a { color: #fff; text-decoration: underline; }

  @media (max-width: 768px) {
    .ae-split { flex-direction: column; }
    .ae-pane-left { border-right: none; border-bottom: 1px solid var(--color-border); flex: 1 1 55%; }
    .ae-pane-left .ae-pane-content textarea { min-height: 200px; }
    .ae-pane:last-child { flex: 1 1 45%; }
    .ae-bottom-bar { gap: 0.6rem; padding: 0.6rem 1rem; }
    .ae-bottom-bar input[type="text"] { width: 90px; }
  }
</style>

<script>
  import { marked } from "marked";

  const TK = "publish_token";
  const RK = "publish_repo";
  const SK_TITLE = "site_title";
  const SK_URL = "site_url";
  const SK_AUTHOR = "site_author";
  const DEFAULT_REPO = "UsephJo/usephjo.github.io";
  const CONTENT_PATH = "src/content/posts";

  function getRepo(): string { return localStorage.getItem(RK) || DEFAULT_REPO; }
  function getSiteTitle(): string { return localStorage.getItem(SK_TITLE) || "usephjo's blog"; }
  function getSiteUrl(): string { return localStorage.getItem(SK_URL) || "https://usephjo.github.io"; }
  function getAuthor(): string { return localStorage.getItem(SK_AUTHOR) || "usephjo"; }
  const DRAFT_KEY = "publish_draft";
  const DRAFT_CATS_KEY = "publish_draft_cats";
  const DRAFT_TAGS_KEY = "publish_draft_tags";
  const DRAFT_RSS_KEY = "publish_draft_rss";
  const DRAFT_DP_KEY = "publish_draft_dp";

  // Build-time posts data
  const postsDataEl = document.getElementById("posts-data");
  const ALL_POSTS = JSON.parse(postsDataEl?.getAttribute("data-posts") || "[]");

  // State containers
  const $setup = document.getElementById("auth-setup")!;
  const $dashboard = document.getElementById("auth-dashboard")!;
  const $editorOverlay = document.getElementById("auth-editor-overlay")!;
  const $postList = document.getElementById("post-list")!;

  // Setup
  const $tokenInput = document.getElementById("token-input") as HTMLInputElement;
  const $btnSave = document.getElementById("btn-save")!;
  const $tokenError = document.getElementById("token-error")!;
  const $tokenVerifying = document.getElementById("token-verifying")!;

  // Settings
  const $settingTitle = document.getElementById("setting-title") as HTMLInputElement;
  const $settingUrl = document.getElementById("setting-url") as HTMLInputElement;
  const $settingAuthor = document.getElementById("setting-author") as HTMLInputElement;
  const $btnSaveSettings = document.getElementById("btn-save-settings")!;

  function applySiteSettings() {
    const title = getSiteTitle();
    document.title = title;
    const headerTitle = document.querySelector(".site-title");
    if (headerTitle) headerTitle.textContent = title;
    // Update og:title
    const ogTitle = document.querySelector('meta[property="og:title"]');
    if (ogTitle) ogTitle.setAttribute("content", title);
  }

  function populateSettings() {
    $settingTitle.value = getSiteTitle();
    $settingUrl.value = getSiteUrl();
    $settingAuthor.value = getAuthor();
  }

  $btnSaveSettings.addEventListener("click", async () => {
    const title = $settingTitle.value.trim() || getSiteTitle();
    const url = $settingUrl.value.trim() || getSiteUrl();
    const author = $settingAuthor.value.trim() || getAuthor();
    localStorage.setItem(SK_TITLE, title);
    localStorage.setItem(SK_URL, url);
    localStorage.setItem(SK_AUTHOR, author);
    applySiteSettings();

    // Push to consts.ts via GitHub API
    const token = localStorage.getItem(TK);
    if (!token) { toast("设置已保存到本地（令牌丢失，未同步到仓库）", "success"); return; }

    try {
      const constsPath = "src/consts.ts";
      const getRes = await fetch(
        `https://api.github.com/repos/${getRepo()}/contents/${constsPath}`,
        { headers: { Authorization: `Bearer ${token}`, Accept: "application/vnd.github+json" } }
      );
      if (!getRes.ok) throw new Error(`HTTP ${getRes.status}`);
      const getData = await getRes.json();
      const sha = getData.sha;
      let content = b64ToUtf8(getData.content);

      // Replace values in consts.ts
      content = content.replace(/(SITE_TITLE\s*=\s*)"[^"]*"/, `$1"${title.replace(/"/g, '\\"')}"`);
      content = content.replace(/(AUTHOR\s*=\s*)"[^"]*"/, `$1"${author.replace(/"/g, '\\"')}"`);
      content = content.replace(/(SITE_URL\s*=\s*)"[^"]*"/, `$1"${url.replace(/"/g, '\\"')}"`);

      const putRes = await fetch(
        `https://api.github.com/repos/${getRepo()}/contents/${constsPath}`,
        {
          method: "PUT",
          headers: {
            Authorization: `Bearer ${token}`,
            "Content-Type": "application/json",
            Accept: "application/vnd.github+json",
          },
          body: JSON.stringify({
            message: "更新站点设置",
            content: toBase64(content),
            sha,
          }),
        }
      );
      if (!putRes.ok) throw new Error(`HTTP ${putRes.status}`);
      toast("设置已保存，站点将在几秒后更新", "success");
    } catch (e) {
      console.error("[auth] save settings to repo:", e);
      toast("设置已保存到本地（同步仓库失败）", "success");
    }
  });

  // Dashboard
  const $btnNewPostSidebar = document.getElementById("btn-new-post-sidebar")!;
  const $btnLogout = document.getElementById("btn-logout")!;

  // Editor
  const $btnCloseEditor = document.getElementById("btn-close-editor")!;
  const $content = document.getElementById("content-area") as HTMLTextAreaElement;
  const $preview = document.getElementById("preview")!;
  const $categories = document.getElementById("categories-input") as HTMLInputElement;
  const $tags = document.getElementById("tags-input") as HTMLInputElement;
  const $rssCheck = document.getElementById("rss-check") as HTMLInputElement;
  const $draftCheck = document.getElementById("draft-check") as HTMLInputElement;
  const $btnPublish = document.getElementById("btn-publish") as HTMLButtonElement;
  const $charCount = document.getElementById("char-count")!;
  const $editorFilename = document.getElementById("editor-filename")!;
  const $editorModeLabel = document.getElementById("editor-mode-label")!;
  const $fileInput = document.getElementById("file-input") as HTMLInputElement;
  const $btnImage = document.getElementById("btn-image")!;
  const $btnLinkCard = document.getElementById("btn-link-card")!;
  const $toast = document.getElementById("toast")!;

  let toastTimer: ReturnType<typeof setTimeout>;
  let publishing = false;
  let editingFile: { filename: string; sha: string; originalDate?: string } | null = null;

  // ===== State =====
  function showState(state: "setup" | "dashboard" | "editor") {
    $setup.style.display = state === "setup" ? "" : "none";
    $dashboard.style.display = state === "dashboard" ? "" : "none";
    $editorOverlay.style.display = state === "editor" ? "" : "none";
  }

  function hasToken() { return !!localStorage.getItem(TK); }

  // ===== Toast =====
  function toast(text: string, type?: string) {
    clearTimeout(toastTimer);
    $toast.className = "auth-toast " + (type ?? "");
    $toast.innerHTML = text;
    requestAnimationFrame(() => $toast.classList.add("show"));
    toastTimer = setTimeout(() => $toast.classList.remove("show"), 3000);
  }

  // ===== Setup → Verify → Dashboard =====
  let verifying = false;
  $btnSave.addEventListener("click", () => {
    console.log("[auth] btn-save clicked");
    if (verifying) { console.log("[auth] already verifying, skip"); return; }
    const t = $tokenInput.value.trim();
    console.log("[auth] token length:", t.length, "starts with ghp_:", t.startsWith("ghp_"));
    if (!t) { $tokenError.style.display = "block"; $tokenError.textContent = "请输入令牌"; return; }
    if (!t.startsWith("ghp_") && !t.startsWith("github_pat_")) {
      $tokenError.style.display = "block";
      $tokenError.textContent = "令牌格式不正确，应为 ghp_ 或 github_pat_ 开头";
      return;
    }

    // Verify token against GitHub API
    verifying = true;
    $btnSave.disabled = true;
    $btnSave.textContent = "验证中...";
    $tokenError.style.display = "none";
    $tokenVerifying.style.display = "block";
    console.log("[auth] fetching GitHub API...");

    fetch("https://api.github.com/user", {
      headers: { Authorization: `Bearer ${t}`, Accept: "application/vnd.github+json" },
    })
      .then((res) => {
        console.log("[auth] response status:", res.status);
        if (!res.ok) {
          const status = res.status;
          if (status === 401) throw new Error("令牌无效或已过期");
          if (status === 403 && t.startsWith("github_pat_")) throw new Error("令牌权限不足，请确保勾选了 repo 权限");
          throw new Error(`验证失败 (HTTP ${status})`);
        }
        return res.json();
      })
      .then((user) => {
        console.log("[auth] logged in as:", user.login);
        localStorage.setItem(TK, t);
        // Auto-derive settings from GitHub username
        const derivedRepo = `${user.login}/${user.login}.github.io`;
        localStorage.setItem(RK, derivedRepo);
        if (!localStorage.getItem(SK_TITLE)) localStorage.setItem(SK_TITLE, `${user.login}'s blog`);
        if (!localStorage.getItem(SK_URL)) localStorage.setItem(SK_URL, `https://${user.login}.github.io`);
        if (!localStorage.getItem(SK_AUTHOR)) localStorage.setItem(SK_AUTHOR, user.login);
        applySiteSettings();
        $tokenVerifying.style.display = "none";
        toast(`欢迎，${user.login}`, "success");
        const pendingEdit = getPendingEdit();
        if (pendingEdit) {
          showState("dashboard");
          openEditPost(pendingEdit);
          clearPendingEdit();
        } else {
          showState("dashboard");
        }
      })
      .catch((e) => {
        console.error("[auth] verify error:", e);
        $tokenVerifying.style.display = "none";
        $tokenError.style.display = "block";
        $tokenError.textContent = e.message;
      })
      .finally(() => {
        verifying = false;
        $btnSave.disabled = false;
        $btnSave.textContent = "验证并进入";
      });
  });
  $tokenInput.addEventListener("keydown", (e) => { if (e.key === "Enter") $btnSave.click(); });

  // ===== Logout =====
  $btnLogout.addEventListener("click", () => {
    if (confirm("确定清除令牌？\n（草稿会被保留）")) {
      localStorage.removeItem(TK);
      localStorage.removeItem(RK);
      showState("setup");
      toast("令牌已清除");
    }
  });

  // ===== Open editor for new post =====
  function openNewPost() {
    editingFile = null;
    $content.value = "";
    $categories.value = "";
    $tags.value = "";
    $rssCheck.checked = true;
    $draftCheck.checked = false;
    $charCount.textContent = "0 字";
    $editorFilename.textContent = "";
    $editorModeLabel.textContent = "新增内容";
    $btnPublish.textContent = "发布";
    $preview.innerHTML = '<span class="ae-placeholder">在左边输入内容，这里会实时渲染……</span>';
    showState("editor");
    $content.focus();
  }

  $btnNewPostSidebar.addEventListener("click", (e) => { e.preventDefault(); openNewPost(); });

  // ===== Check pending edit from URL param =====
  function getPendingEdit(): string | null {
    return new URLSearchParams(location.search).get("edit");
  }

  function clearPendingEdit() {
    const url = new URL(location.href);
    url.searchParams.delete("edit");
    history.replaceState(null, "", url);
  }

  // ===== UTF-8 base64 helpers =====
  function b64ToUtf8(b64: string): string {
    const binary = atob(b64);
    const bytes = new Uint8Array(binary.length);
    for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
    return new TextDecoder("utf-8").decode(bytes);
  }

  // ===== Open editor for editing existing post =====
  async function openEditPost(filename: string) {
    const token = localStorage.getItem(TK);
    if (!token) { toast("令牌丢失，请重新登录", "error"); showState("setup"); return; }

    toast("正在加载文章...");
    try {
      const res = await fetch(
        `https://api.github.com/repos/${getRepo()}/contents/${CONTENT_PATH}/${filename}`,
        { headers: { Authorization: `Bearer ${token}`, Accept: "application/vnd.github+json" } }
      );
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      const raw = b64ToUtf8(data.content);
      const sha = data.sha;

      // Parse frontmatter
      const fmMatch = raw.match(/^---\n([\s\S]*?)\n---\n([\s\S]*)$/);
      let body = raw;
      if (fmMatch) {
        const fm = fmMatch[1];
        body = fmMatch[2].trim();
        const titleMatch = fm.match(/title:\s*"([^"]*)"/);
        const dateMatch = fm.match(/date:\s*(\S+)/);
        const catsMatch = fm.match(/categories:\s*\[([^\]]*)\]/);
        const tagsMatch = fm.match(/tags:\s*\[([^\]]*)\]/);
        const rssMatch = fm.match(/rss:\s*(true|false)/);
        const draftMatch = fm.match(/draft:\s*(true|false)/);

        if (titleMatch) {
          // Prepend title as first line for the editor
          body = `# ${titleMatch[1]}\n\n${body}`;
        }
        if (catsMatch) {
          $categories.value = catsMatch[1].split(",").map((s: string) => s.trim()).filter(Boolean).join(", ");
        } else {
          $categories.value = "";
        }
        if (tagsMatch) {
          $tags.value = tagsMatch[1].split(",").map((s: string) => s.trim()).filter(Boolean).join(", ");
        } else {
          $tags.value = "";
        }
        if (rssMatch) {
          $rssCheck.checked = rssMatch[1] === "true";
        }
        if (draftMatch) {
          $draftCheck.checked = draftMatch[1] === "true";
        } else {
          $draftCheck.checked = false;
        }
      } else {
        $categories.value = "";
        $tags.value = "";
      }

      $content.value = body;
      $charCount.textContent = `${body.length} 字`;
      editingFile = { filename, sha, originalDate: dateMatch?.[1] };
      $editorFilename.textContent = filename;
      $editorModeLabel.textContent = "编辑文章";
      $btnPublish.textContent = "更新";
      updatePreview();
      showState("editor");
      $content.focus();
      toast("文章已加载");
    } catch (e) {
      toast(`加载失败：${(e as Error).message}`, "error");
    }
  }

  // Attach edit handlers to post list buttons
  $postList.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest(".btn-edit-post") as HTMLElement | null;
    if (btn) {
      e.preventDefault();
      const filename = btn.dataset.filename;
      if (filename) openEditPost(filename);
    }
  });

  // ===== Close editor =====
  $btnCloseEditor.addEventListener("click", () => {
    if ($content.value.trim() && !confirm("返回面板将保留草稿，确定？")) return;
    saveDraft();
    showState("dashboard");
  });

  // ===== Cursor helper =====
  function insertAtCursor(text: string) {
    const start = $content.selectionStart;
    const end = $content.selectionEnd;
    $content.value = $content.value.slice(0, start) + text + $content.value.slice(end);
    $content.selectionStart = $content.selectionEnd = start + text.length;
    $content.focus();
    $content.dispatchEvent(new Event("input"));
  }

  // ===== Image upload to GitHub =====
  async function uploadImageToGithub(file: File): Promise<string> {
    const token = localStorage.getItem(TK);
    if (!token) throw new Error("令牌丢失");

    const ext = file.type === "image/png" ? "png" : file.type === "image/gif" ? "gif" : "jpg";
    const now = new Date();
    const pad = (n: number) => String(n).padStart(2, "0");
    const ts = `${now.getFullYear()}${pad(now.getMonth() + 1)}${pad(now.getDate())}-${pad(now.getHours())}${pad(now.getMinutes())}${pad(now.getSeconds())}`;
    const baseName = file.name.replace(/\.[^.]+$/, "").replace(/[^a-zA-Z0-9一-鿿_-]/g, "").slice(0, 40) || "image";
    const filename = `${ts}-${baseName}.${ext}`;

    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => {
        const full = reader.result as string;
        const b64 = full.slice(full.indexOf(",") + 1);
        fetch(`https://api.github.com/repos/${getRepo()}/contents/public/images/${filename}`, {
          method: "PUT",
          headers: {
            Authorization: `Bearer ${token}`,
            "Content-Type": "application/json",
            Accept: "application/vnd.github+json",
          },
          body: JSON.stringify({ message: `上传图片 ${filename}`, content: b64 }),
        })
          .then((res) => {
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            return res.json();
          })
          .then(() => resolve(`/images/${filename}`))
          .catch(reject);
      };
      reader.onerror = () => reject(new Error("读取图片失败"));
      reader.readAsDataURL(file);
    });
  }

  function handleImageUpload(file: File, alt?: string) {
    uploadImageToGithub(file)
      .then((path) => {
        insertAtCursor(`\n![${alt || file.name.replace(/\.[^.]+$/, "")}](${path})\n`);
        toast("图片已上传到 GitHub");
      })
      .catch((e) => {
        // Fallback to base64 on failure
        const reader = new FileReader();
        reader.onload = () => { insertAtCursor(`\n![image](${reader.result as string})\n`); toast("上传失败，已转为内嵌图片", "error"); };
        reader.readAsDataURL(file);
      });
  }

  $btnImage.addEventListener("click", () => $fileInput.click());
  $fileInput.addEventListener("change", () => {
    const files = $fileInput.files;
    if (!files || files.length === 0) return;
    toast(`正在上传 ${files.length} 张图片到 GitHub...`);
    for (const file of Array.from(files)) handleImageUpload(file);
    $fileInput.value = "";
  });

  // ===== Image paste =====
  $content.addEventListener("paste", (e: ClipboardEvent) => {
    const items = e.clipboardData?.items;
    if (!items) return;
    for (const item of Array.from(items)) {
      if (item.type.startsWith("image/")) {
        e.preventDefault();
        const file = item.getAsFile();
        if (!file) continue;
        handleImageUpload(file, "image");
        return;
      }
    }
  });

  // ===== Link card =====
  const URL_RE = /https?:\/\/[^\s<>"']+/gi;

  function extractDomain(url: string): string {
    try { return new URL(url).hostname.replace(/^www\./, ""); } catch { return url; }
  }

  function buildLinkCardHTML(url: string, meta?: { title?: string; desc?: string; image?: string }): string {
    const domain = extractDomain(url);
    const displayTitle = meta?.title || domain;
    const displayDesc = meta?.desc || "";
    const thumbHTML = meta?.image
      ? `<span class="link-card-thumb"><img src="${meta.image}" alt="" onerror="this.parentElement.style.display='none'" /></span>`
      : "";
    const descHTML = displayDesc ? `<span class="link-card-desc">${displayDesc}</span>` : "";
    return `<a href="${url}" target="_blank" rel="noopener" class="link-card">${thumbHTML}<span class="link-card-body"><strong>${displayTitle}</strong>${descHTML}<span class="link-card-domain">${domain}</span></span></a>`;
  }

  async function tryFetchMetadata(url: string) {
    try {
      const ctrl = new AbortController();
      const t = setTimeout(() => ctrl.abort(), 4000);
      const res = await fetch(url, { signal: ctrl.signal });
      clearTimeout(t);
      if (!res.ok) return null;
      const html = await res.text();
      return {
        title: (html.match(/<meta\s+property="og:title"\s+content="([^"]+)"/i) || [])[1]
          || (html.match(/<title[^>]*>([^<]+)<\/title>/i) || [])[1]?.trim(),
        desc: (html.match(/<meta\s+property="og:description"\s+content="([^"]+)"/i) || [])[1]
          || (html.match(/<meta\s+name="description"\s+content="([^"]+)"/i) || [])[1],
        image: (html.match(/<meta\s+property="og:image"\s+content="([^"]+)"/i) || [])[1],
      };
    } catch { return null; }
  }

  async function insertLinkCard(url: string) {
    if (isWechatUrl(url)) {
      insertAtCursor(`\n${buildWechatCardHTML(url)}\n\n`);
      toast("微信文章卡片已插入", "success");
      return;
    }
    toast("正在获取页面信息...");
    const meta = await tryFetchMetadata(url);
    insertAtCursor(`\n${buildLinkCardHTML(url, meta || undefined)}\n\n`);
    toast(meta?.title ? "链接卡片已插入" : `已插入链接卡片（${extractDomain(url)}）`, "success");
  }

  $btnLinkCard.addEventListener("click", () => {
    const url = prompt("粘贴网页链接：");
    if (url && URL_RE.test(url.trim())) insertLinkCard(url.trim());
    else if (url) toast("请输入有效的 URL", "error");
  });

  // WeChat article detection
  function isWechatUrl(url: string): boolean {
    return /mp\.weixin\.qq\.com/.test(url);
  }

  function buildWechatCardHTML(url: string): string {
    return `<a href="${url}" target="_blank" rel="noopener" class="link-card link-card-wechat"><span class="link-card-thumb" style="background:#07c160;display:flex;align-items:center;justify-content:center;"><span style="color:#fff;font-size:1.2rem;font-weight:700;">微</span></span><span class="link-card-body"><strong>微信公众号文章</strong><span class="link-card-desc">点击阅读原文</span><span class="link-card-domain">mp.weixin.qq.com</span></span></a>`;
  }

  // Apple Music detection
  function detectAppleMusicEmbed(text: string): { html: string } | null {
    const iframeMatch = text.match(/<iframe[^>]*src="(https:\/\/embed\.music\.apple\.com\/[^"]*)"[^>]*><\/iframe>/i);
    if (iframeMatch) {
      return { html: `<div class="apple-music-embed"><iframe allow="autoplay *; encrypted-media *;" frameborder="0" sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-storage-access-by-user-activation allow-top-navigation-by-user-activation" src="${iframeMatch[1]}"></iframe></div>` };
    }
    const shareMatch = text.match(/https:\/\/music\.apple\.com\/\S+/i);
    if (shareMatch) {
      return { html: `<div class="apple-music-embed"><iframe allow="autoplay *; encrypted-media *;" frameborder="0" sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-storage-access-by-user-activation allow-top-navigation-by-user-activation" src="${shareMatch[0].replace(/music\.apple\.com/, "embed.music.apple.com")}"></iframe></div>` };
    }
    return null;
  }

  // Bilibili detection
  function detectBilibiliEmbed(text: string): { html: string } | null {
    const match = text.match(/bilibili\.com\/video\/(BV[a-zA-Z0-9]+)/);
    if (!match) return null;
    return { html: `<div class="video-embed"><iframe src="https://player.bilibili.com/player.html?bvid=${match[1]}" allowfullscreen style="width:100%;aspect-ratio:16/9;border:none;border-radius:8px;"></iframe></div>` };
  }

  // YouTube detection
  function detectYoutubeEmbed(text: string): { html: string } | null {
    let vid = "";
    const shortMatch = text.match(/youtu\.be\/([a-zA-Z0-9_-]+)/);
    if (shortMatch) { vid = shortMatch[1]; }
    const longMatch = text.match(/youtube\.com\/watch\?v=([a-zA-Z0-9_-]+)/);
    if (longMatch) { vid = longMatch[1]; }
    if (!vid) return null;
    return { html: `<div class="video-embed"><iframe src="https://www.youtube.com/embed/${vid}" allowfullscreen style="width:100%;aspect-ratio:16/9;border:none;border-radius:8px;"></iframe></div>` };
  }

  $content.addEventListener("paste", (e: ClipboardEvent) => {
    const text = e.clipboardData?.getData("text/plain");
    if (!text?.trim()) return;
    const trimmed = text.trim();
    const am = detectAppleMusicEmbed(trimmed);
    if (am) { e.preventDefault(); insertAtCursor(`\n${am.html}\n\n`); toast("Apple Music 嵌入已插入"); return; }
    const bl = detectBilibiliEmbed(trimmed);
    if (bl) { e.preventDefault(); insertAtCursor(`\n${bl.html}\n\n`); toast("Bilibili 播放器已插入"); return; }
    const yt = detectYoutubeEmbed(trimmed);
    if (yt) { e.preventDefault(); insertAtCursor(`\n${yt.html}\n\n`); toast("YouTube 播放器已插入"); return; }
    if (URL_RE.test(trimmed) && trimmed.split(/\s+/).length === 1) {
      e.preventDefault(); insertLinkCard(trimmed);
    }
  });

  // ===== Live Preview =====
  const renderer = new marked.Renderer();

  function slugify(s: string): string {
    return s.toLowerCase().replace(/[^\w一-鿿]+/g, "-").replace(/^-|-$/g, "").slice(0, 60) || "untitled";
  }

  function preprocessObsidian(md: string): string {
    let text = md;

    // Highlights
    text = text.replace(/==([^=\n]+)==/g, "<mark>$1</mark>");

    // Image embeds
    text = text.replace(/!\[\[([^\]]+)\]\]/g, (_m: string, file: string) =>
      `<img src="/images/${file}" alt="${file}" loading="lazy" />`
    );

    // Wikilinks
    text = text.replace(/\[\[([^\]|#]+)(?:#([^\]|]+))?(?:\|([^\]]+))?\]\]/g, (_m: string, page: string, _h: string, alias: string) =>
      `[${alias || page}](/posts/${slugify(page)}/)`
    );

    // Callouts: collect consecutive > lines starting with [!type]
    const lines = text.split("\n");
    const out: string[] = [];
    for (let i = 0; i < lines.length; i++) {
      const calloutMatch = lines[i].match(/^>\s*\[!(\w+)\]\s*(.*)/i);
      if (calloutMatch) {
        const type = calloutMatch[1].toLowerCase();
        let title = calloutMatch[2] || type.toUpperCase();
        const bodyLines: string[] = [];
        i++;
        while (i < lines.length && lines[i].match(/^>/)) {
          bodyLines.push(lines[i].replace(/^>\s?/, ""));
          i++;
        }
        i--; // back up one because the for loop will increment
        out.push(`<aside class="callout callout-${type}"><span class="callout-title">${title}</span>\n\n${bodyLines.join("\n")}\n\n</aside>`);
      } else {
        out.push(lines[i]);
      }
    }

    return out.join("\n");
  }

  function updatePreview() {
    const raw = $content.value;
    if (!raw.trim()) {
      $preview.innerHTML = '<span class="ae-placeholder">在左边输入内容，这里会实时渲染……</span>';
      return;
    }
    try {
      $preview.innerHTML = marked.parse(preprocessObsidian(raw), { renderer, breaks: true }) as string;
    } catch (e) {
      console.error("Preview error:", e);
      $preview.innerHTML = '<span class="draft-badge">预览渲染失败</span>';
    }
  }

  // ===== Draft =====
  function saveDraft() {
    localStorage.setItem(DRAFT_KEY, $content.value);
    localStorage.setItem(DRAFT_CATS_KEY, $categories.value);
    localStorage.setItem(DRAFT_TAGS_KEY, $tags.value);
    localStorage.setItem(DRAFT_RSS_KEY, String($rssCheck.checked));
  }
  function clearDraft() {
    localStorage.removeItem(DRAFT_KEY);
    localStorage.removeItem(DRAFT_CATS_KEY);
    localStorage.removeItem(DRAFT_TAGS_KEY);
    localStorage.removeItem(DRAFT_RSS_KEY);
  }

  let previewTimer: ReturnType<typeof setTimeout>;
  $content.addEventListener("input", () => {
    $charCount.textContent = `${$content.value.length} 字`;
    clearTimeout(previewTimer);
    previewTimer = setTimeout(() => { updatePreview(); saveDraft(); }, 300);
  });
  $categories.addEventListener("input", saveDraft);
  $tags.addEventListener("input", saveDraft);
  $rssCheck.addEventListener("change", saveDraft);

  // ===== Publish / Update =====
  function toBase64(str: string): string {
    const bytes = new TextEncoder().encode(str);
    let bin = "";
    for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
    return btoa(bin);
  }

  function parseTitleFromBody(raw: string): { title: string; body: string } {
    const lines = raw.split("\n");
    let title = lines[0].replace(/^#\s+/, "").trim();
    let bodyStart = 1;
    while (bodyStart < lines.length && lines[bodyStart].trim() === "") bodyStart++;
    const body = lines.slice(bodyStart).join("\n").trim();
    return { title: title || "Untitled", body };
  }

  async function publishOrUpdate() {
    if (publishing) return;
    const raw = $content.value;
    if (!raw.trim()) { toast("请输入内容", "error"); return; }

    const { title, body } = parseTitleFromBody(raw);
    if (!body) { toast("正文不能为空", "error"); return; }

    const token = localStorage.getItem(TK);
    if (!token) { toast("令牌丢失，请重新登录", "error"); showState("setup"); return; }

    const cats = $categories.value.split(",").map((s: string) => s.trim()).filter(Boolean);
    const tags = $tags.value.split(",").map((s: string) => s.trim()).filter(Boolean);
    const rss = $rssCheck.checked;

    const now = new Date();
    const pad2 = (n: number) => String(n).padStart(2, "0");
    const today = `${now.getFullYear()}-${pad2(now.getMonth() + 1)}-${pad2(now.getDate())}T${pad2(now.getHours())}:${pad2(now.getMinutes())}`;
    const slug = slugify(title);
    const ts = now.getTime().toString(36);
    const filename = editingFile ? editingFile.filename : `${slug}-${ts}.md`;

    const esc = (s: string) => s.replace(/"/g, '\\"');
    const catsYaml = cats.length ? `categories: [${cats.join(", ")}]` : "categories: []";
    const tagsYaml = tags.length ? `tags: [${tags.join(", ")}]` : "tags: []";
    const desc = esc(body.replace(/\n/g, " ").slice(0, 120));

    const isUpdate = !!editingFile;
    const dateLine = isUpdate && editingFile?.originalDate
      ? `date: ${editingFile.originalDate}`
      : `date: ${today}`;
    const updatedLine = isUpdate ? `updated: ${today}` : "";
    const draftLine = $draftCheck.checked ? `draft: true` : "";

    const fmLines = [
      "---",
      `title: "${esc(title)}"`,
      dateLine,
      catsYaml,
      tagsYaml,
      `rss: ${rss}`,
      `description: "${desc}"`,
    ];
    if (draftLine) fmLines.push(draftLine);
    if (updatedLine) fmLines.push(updatedLine);
    fmLines.push("---", "", body, "");
    const fm = fmLines.join("\n");

    publishing = true;
    $btnPublish.disabled = true;
    $btnPublish.textContent = isUpdate ? "更新中..." : "发布中...";

    try {
      const bodyObj: Record<string, unknown> = {
        message: `${isUpdate ? "更新" : "发布"}: ${title}`,
        content: toBase64(fm),
      };
      if (editingFile?.sha) bodyObj.sha = editingFile.sha;

      const res = await fetch(
        `https://api.github.com/repos/${getRepo()}/contents/${CONTENT_PATH}/${filename}`,
        {
          method: "PUT",
          headers: {
            Authorization: `Bearer ${token}`,
            "Content-Type": "application/json",
            Accept: "application/vnd.github+json",
          },
          body: JSON.stringify(bodyObj),
        }
      );

      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        const status = res.status;
        if (status === 401) throw new Error("令牌无效或已过期，请重新设置");
        if (status === 403) throw new Error("令牌权限不足，创建时需勾选 repo 权限");
        if (status === 409) throw new Error("文件已被其他人修改，请刷新后重试");
        throw new Error((err as any).message || `HTTP ${status}`);
      }

      const updatedData = await res.json();
      // Update sha for subsequent edits
      if (updatedData.content?.sha) {
        editingFile = { filename, sha: updatedData.content.sha };
      }

      toast(
        isUpdate
          ? `已更新！稍后访问 <a href="/posts/${slug}/">/${slug}/</a>`
          : `已发布！稍后访问 <a href="/posts/${slug}-${ts}/">/${slug}-${ts}</a>`,
        "success"
      );

      // Update post list entry
      if (isUpdate) {
        updatePostInList(filename, title, today, cats, tags, rss, $draftCheck.checked, slug);
      } else {
        addPostToList(filename, title, today, cats, tags, rss, $draftCheck.checked, slug, ts);
      }

      // Publish done — return to dashboard
      clearDraft();
      editingFile = null;
      $content.value = "";
      $categories.value = "";
      $tags.value = "";
      $rssCheck.checked = true;
      $charCount.textContent = "0 字";
      $editorModeLabel.textContent = "新增内容";
      $btnPublish.textContent = "发布";
      showState("dashboard");
    } catch (e) {
      const msg = (e as Error).message;
      if (msg.includes("令牌")) {
        toast(`发布失败：${msg}。<br/><a href="#" id="toast-reset-token" style="text-decoration:underline;">点此重新设置令牌</a>`, "error");
        setTimeout(() => {
          const link = document.getElementById("toast-reset-token");
          if (link) link.addEventListener("click", (ev) => {
            ev.preventDefault();
            localStorage.removeItem(TK);
            showState("setup");
            toast("请粘贴新的令牌");
          });
        }, 50);
      } else {
        toast(`发布失败：${msg}`, "error");
      }
    } finally {
      publishing = false;
      $btnPublish.disabled = false;
      $btnPublish.textContent = isUpdate ? "更新" : "发布";
    }
  }

  function updatePostInList(filename: string, title: string, dateStr: string, cats: string[], tags: string[], rss: boolean, draft: boolean, slug: string) {
    const item = $postList.querySelector(`[data-filename="${CSS.escape(filename)}"]`) as HTMLElement | null;
    if (!item) return;
    const titleEl = item.querySelector(".post-item-title") as HTMLElement | null;
    const metaEl = item.querySelector(".post-item-meta");
    const viewLink = item.querySelector(".post-item-actions a") as HTMLElement | null;
    if (titleEl) titleEl.textContent = title;
    if (metaEl) {
      metaEl.innerHTML = `<time>${new Date(dateStr).toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" })}</time>${draft ? '<span class="draft-badge"> · 私密</span>' : ""}${cats.length ? " · " + cats.join(", ") : ""}${!rss ? '<span class="rss-badge"> · 未推送</span>' : ""}`;
    }
    if (viewLink) viewLink.href = `/posts/${slug}/`;
  }

  function addPostToList(filename: string, title: string, dateStr: string, cats: string[], tags: string[], rss: boolean, draft: boolean, slug: string, ts: string) {
    const div = document.createElement("div");
    div.className = "post-item";
    div.dataset.filename = filename;
    div.innerHTML = `
      <div class="post-item-main">
        <a href="/posts/${slug}-${ts}/" class="post-item-title">${title}</a>
        <div class="post-item-meta">
          <time>${new Date(dateStr).toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" })}</time>
          ${draft ? '<span class="draft-badge"> · 私密</span>' : ""}
          ${cats.length ? " · " + cats.join(", ") : ""}
          ${!rss ? '<span class="rss-badge"> · 未推送</span>' : ""}
        </div>
      </div>
      <div class="post-item-actions">
        <button class="btn-edit-post auth-btn-sm" data-filename="${filename}">编辑</button>
        <a href="/posts/${slug}-${ts}/" class="post-item-link">查看</a>
      </div>`;
    $postList.insertBefore(div, $postList.firstChild);
    // Remove empty state if exists
    const emptyMsg = $postList.querySelector("p");
    if (emptyMsg) emptyMsg.remove();
  }

  $btnPublish.addEventListener("click", publishOrUpdate);

  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === "Enter") {
      e.preventDefault();
      if (hasToken() && $editorOverlay.style.display !== "none") publishOrUpdate();
    }
  });

  // ===== Init =====
  if (hasToken()) {
    populateSettings();
    applySiteSettings();
    const pendingEdit = getPendingEdit();
    if (pendingEdit) {
      showState("dashboard");
      openEditPost(pendingEdit);
      clearPendingEdit();
    } else {
      showState("dashboard");
    }
  } else {
    showState("setup");
  }
</script>
</BaseLayout>
