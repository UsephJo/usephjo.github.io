---
import { SITE_TITLE, NAV_LINKS } from "../consts";

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <nav>
    <a href="/" class="site-title">{SITE_TITLE}</a>
    {NAV_LINKS.map((link) => (
      <a
        href={link.href}
        class:list={["nav-link", { active: currentPath === link.href }]}
      >
        {link.label}
      </a>
    ))}
    <a href="/auth" class="nav-login">登录</a>
  </nav>
</header>

<style>
  .nav-login {
    margin-left: auto;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    opacity: 0.45;
    transition: opacity 0.15s;
  }
  .nav-login:hover {
    opacity: 1;
    text-decoration: none;
  }
</style>
